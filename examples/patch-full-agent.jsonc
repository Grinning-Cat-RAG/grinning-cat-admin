// The "everything" example: copy it, delete the sections you do not need.
// Every section below goes through the same read-merge-write path as the
// equivalent --set/--llm/--plugin flag. Comments and trailing commas are JSONC.
{
  // Agent metadata: merged into the existing metadata dict.
  "metadata": { "name": "Corso 1", "label": "production", "owner": "didattica" },

  // LLM configuration. openrouter.ai provides the model parameters, so model
  // must be a valid OpenRouter model id.
  "llm": {
    "openrouter": {
      "model": "anthropic/claude-3.5-sonnet",
      "temperature": 0.2
    }
  },

  // Chunker configuration: only the keys you pass change, siblings are preserved.
  "chunking": {
    "default": {
      "chunk_size": 512,
      "chunk_overlap": 32
    }
  },

  /* Per-plugin settings. Every plugin named here must be installed on every
     selected agent, otherwise that agent fails and the other agents continue. */
  "plugins": {
    "my_plugin": { "options": { "enabled": true, "threshold": 0.7 } },
    "other_plugin": { "api_key": "REPLACE-ME" }
  },

  // Active plugin set: true enables, false disables. Reconciled like --plugin,
  // so a repeated run never toggles twice. An explicit --plugin NAME=on|off on
  // the command line wins over the same name here.
  "active_plugins": {
    "my_plugin": true,
    "other_plugin": false
  }
}
