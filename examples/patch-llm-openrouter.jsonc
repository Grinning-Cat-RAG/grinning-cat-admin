// One LLM change: the OpenRouter configuration used from ADMIN.
// Copy this file, adapt it, then run:
//   uv run python scripts/batch_agent_update.py --agent corso --patch examples/patch-llm-openrouter.jsonc
// Add --yes only after the dry-run plan looks right.
{
  "llm": {
    "openrouter": {
      // openrouter.ai provides the model parameters, so model must be a valid OpenRouter id.
      "model": "anthropic/claude-3.5-sonnet",
      // Prefer passing a real secret with --set llm:openrouter:api_key=... instead.
      "api_key": "sk-or-REPLACE-ME",
      "temperature": 0.2
    }
  }
}
